{
  "name": "terminal42",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Copilot CLI desktop wrapper",
  "main": "./out/main/index.js",
  "author": "Akwasi Fosuhene",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac",
    "package:win": "electron-vite build && electron-builder --config electron-builder.yml --win",
    "package:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir"
  },
  "dependencies": {
    "@electron/rebuild": "^4.0.4",
    "@github/copilot-sdk": "^1.0.7-preview.2",
    "@paper-design/shaders-react": "^0.0.76",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^3.6.0",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.3.9",
    "kiwi-schema": "^0.5.0",
    "mammoth": "^1.12.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "node-pty": "^1.1.0",
    "pako": "^3.0.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "react-markdown": "^10.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
